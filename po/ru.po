msgstr "Папка тем перечитана."

msgid "Reads the theme folder again, for example after you edited or added files"
msgstr "Заново читает папку тем, например после изменения или добавления файлов"

msgid "Refresh Aircraft"
msgstr "Обновить самолёты"

msgid "Reload from theme folder"
msgstr "Перечитать из папки тем"

msgid "Remove all defaults of this collection"
msgstr "Удалить все значения по умолчанию этой коллекции"

msgid "Remove all own values, the theme then looks like its collection"
msgstr ""
"Удалить все собственные значения, тема тогда будет выглядеть как её коллекция"

msgid "Remove color"
msgstr "Удалить цвет"

msgid "Resolution:"
msgstr "Разрешение:"

